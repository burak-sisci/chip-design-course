{
  "permissions": {
    "deny": [
      "Edit(/rtl/**)",
      "Edit(/tb/**)",
      "Edit(/sw/**)",
      "Write(/rtl/**)",
      "Write(/tb/**)",
      "Write(/sw/**)",
      "NotebookEdit(/rtl/**)",
      "NotebookEdit(/tb/**)",
      "NotebookEdit(/sw/**)",
      "Edit(/.claude/**)",
      "Write(/.claude/**)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/koruma.py\" pre"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/koruma.py\" post"
          }
        ]
      }
    ]
  },
  "attribution": {
    "commit": "",
    "pr": ""
  }
}
